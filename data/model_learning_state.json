  "lessons_learned": [
    {
      "id": "shrinkage_2025",
      "title": "1. Estabilización Bayesiana por Muestra (Prior 2025 + Curva Cuadrática w_s)",
      "impact_gain": "+18.7% acierto Sem. 2",
      "finding": "En Semanas 1–3, el PPG 2026 puro tenía alta varianza muestral (corr +0.035 en Walk-Forward) por rivales extremos.",
      "correction": "Curva cuadrática w_s(N) = (N-0.5)² / ((N-0.5)² + 2.6²) combinada con el Prior 2025 nflfastR (peso 0.36, corr +0.332).",
      "detail": "En Semanas 1–3, el PPG 2026 puro tenía alta varianza (corr +0.035 en Walk-Forward). Al ponderar dinámicamente el Prior 2025 nflfastR (corr +0.332) y EPA/Play según w_s(N) = (N-0.5)² / ((N-0.5)² + 2.6²), el acierto en Semana 2 subió de 43.8% a 62.5% y el error MAE bajó 6.7 pts."
    },
    {
      "id": "orthogonal_tactical",
      "title": "2. Eliminación de Doble Conteo en Bloques Tácticos (Aéreo, Terrestre y Situacional)",
      "impact_gain": "-1.70 pts error MAE",
      "finding": "El motor v1 sumaba diferenciales de barras aéreas (0.072), terrestres (0.050) y situacionales (0.045) duplicando la varianza del PPG base.",
      "correction": "Ortogonalización de coeficientes a 0.036 / 0.025 / 0.0225 y xRobos a 0.24 por lado, reduciendo el MAE de 10.97 a 9.27 pts.",
      "detail": "El motor v1 sumaba los diferenciales de barras aéreas (0.072), terrestres (0.050) y situacionales (0.045) duplicando la varianza del PPG base (desvío estándar de margen = 10.88 pts). Ortogonalizar los coeficientes a 0.036 / 0.025 / 0.0225 redujo el MAE global de 10.97 a 9.27 pts."
    },
    {
      "id": "dynamic_hfa_total",
      "title": "3. Recalibración Automática de Localía (HFA) y Línea Base de Salud",
      "impact_gain": "Sesgo Total < 0.4 pts",
      "finding": "En 166 partidos de 2026, los locales ganaron 51.2% y todo equipo carga ~0.95 pts de penalización media por bajas.",
      "correction": "Ajuste bayesiano semanal de HFA (+0.50 pts netos) + Línea Base de Salud (+0.95 pts) + offset (+0.81 pts).",
      "detail": "En los 166 partidos completados de 2026, los locales ganaron 51.2% (margen medio local -0.50 pts) y el total real fue 46.37 pts. La rutina corrigió el HFA fijo (+1.40 pts netos) a +0.50 pts netos y compensó la línea base de lesiones (+0.95 pts)."
    },
    {
      "id": "market_epa_anchor",
      "title": "4. Ancla Pre-Partido nflfastR + Diferencial EPA/Play y Equipos Especiales",
      "impact_gain": "57.3% ➔ 65.3% Walk-Forward",
      "finding": "El diferencial de EPA/Play (corr +0.594) y la línea de consenso nflfastR (corr +0.333) capturan información estructural clave.",
      "correction": "Integración de EPA/Play (peso 0.38) y ancla pre-partido adaptativa (0.45 inicial ➔ 0.05 con muestra alta).",
      "detail": "Combinar las métricas propias de trincheras con el diferencial de EPA/Play (peso 0.38) y el consenso pre-partido de nflfastR elevó el acierto Walk-Forward de 57.3% (86/150) a 65.3% (98/150) y el Retrospectivo Acumulado de 70.5% (117/166) a 69.3% (115/166)."
